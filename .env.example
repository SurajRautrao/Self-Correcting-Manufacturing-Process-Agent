# Copy to .env and fill in locally. Never commit .env.
# Placeholders only — no real values belong in this file.

# Which planner/repair backend to use: mock | ollama
SCMPA_LLM_PROVIDER=mock
SCMPA_LLM_MODEL=qwen3.5:9b

OLLAMA_BASE_URL=http://localhost:11434

# Repair loop budget (spec default: 3)
SCMPA_MAX_REPAIRS=3
